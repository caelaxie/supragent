{
  "skill_name": "multi-agent-code-review",
  "version": "1.0.0",
  
  "agents": {
    "lead-architect": {
      "enabled": true,
      "priority": 1,
      "focus_areas": ["architecture", "scalability", "design_patterns", "coupling"]
    },
    "security-expert": {
      "enabled": true,
      "priority": 1,
      "focus_areas": ["owasp", "injection", "authentication", "secrets", "supply_chain"]
    },
    "performance-engineer": {
      "enabled": true,
      "priority": 2,
      "focus_areas": ["complexity", "bottlenecks", "memory", "unused_code"]
    },
    "maintainability-guru": {
      "enabled": true,
      "priority": 2,
      "focus_areas": ["naming", "comments", "solid", "testability", "readability"]
    },
    "edge-case-specialist": {
      "enabled": true,
      "priority": 3,
      "focus_areas": ["nulls", "concurrency", "i18n", "scale", "testing"]
    },
    "junior-dev-simulator": {
      "enabled": true,
      "priority": 3,
      "focus_areas": ["confusion", "implicit_assumptions", "missing_docs"]
    }
  },
  
  "severity_levels": {
    "critical": {
      "color": "#FF0000",
      "weight": 100,
      "description": "Security vulnerabilities, data loss risks, crashes"
    },
    "high": {
      "color": "#FF6600", 
      "weight": 50,
      "description": "Performance issues, architectural flaws, major bugs"
    },
    "medium": {
      "color": "#FFCC00",
      "weight": 25,
      "description": "Maintainability issues, edge cases, missing tests"
    },
    "low": {
      "color": "#009900",
      "weight": 10,
      "description": "Style issues, minor optimizations, suggestions"
    }
  },
  
  "consensus": {
    "min_agreement": 2,
    "auto_escalate_critical": true,
    "include_code_suggestions": true,
    "max_suggestions_per_finding": 3
  },
  
  "output": {
    "format": "markdown",
    "include_per_agent_details": true,
    "include_consensus_summary": true,
    "include_suggested_fixes": true,
    "max_findings_per_severity": 20
  },
  
  "runtime": {
    "timeout_seconds": 300,
    "parallel_execution": true,
    "max_concurrent_agents": 6
  }
}
